# OCR Test Playground - Production Environment Configuration
# Copy this file to .env.production and fill in your actual API keys

# =============================================================================
# GOOGLE CLOUD VISION API
# =============================================================================
# Path to your Google Cloud service account JSON key file
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-cloud-service-account.json

# Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# =============================================================================
# GOOGLE GEMINI API
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# GOOGLE DOCUMENT AI
# =============================================================================
# Document AI Processor ID (create processor in Cloud Console)
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-processor-id

# Document AI Processor Location (e.g., us, eu)
GOOGLE_DOCUMENT_AI_PROCESSOR_LOCATION=us

# =============================================================================
# AZURE DOCUMENT INTELLIGENCE (FORMERLY FORM RECOGNIZER)
# =============================================================================
# Get from: https://portal.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key-here

# =============================================================================
# AWS CREDENTIALS (for Textract - optional)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_TEXTRACT_REGION=ap-northeast-1

# =============================================================================
# DATABASE
# =============================================================================
# This is automatically set by docker-compose, no need to change
DATABASE_URL=postgresql://ocr_user:ocr_password@postgres:5432/ocr_test_db

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Mastra logging level (debug, info, warn, error)
MASTRA_LOG_LEVEL=info

# Node environment
NODE_ENV=production
