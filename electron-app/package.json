{
  "name": "ocr-testing-tool",
  "version": "1.0.0",
  "description": "Standalone OCR Testing Tool with Floor Plan to Revit Conversion",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "Your Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "preview": "vite preview",
    "electron:dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.0.0",
    "@google-cloud/documentai": "^9.5.0",
    "@google-cloud/vision": "^4.3.2",
    "@google/generative-ai": "^0.21.0",
    "date-fns": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "fast-levenshtein": "^3.0.0",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jimp": "^0.22.12",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "react-i18next": "^16.3.3",
    "sharp": "^0.34.5",
    "string-similarity": "^4.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/i18next": "^12.1.0",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/string-similarity": "^4.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-electron": "^0.28.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.yourcompany.ocr-testing-tool",
    "productName": "OCR Testing Tool",
    "directories": {
      "output": "dist-installers"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  }
}
