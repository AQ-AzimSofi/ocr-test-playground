{
  "name": "ocr-test-playground",
  "version": "1.0.0",
  "description": "R&D testing playground for OCR/AI extraction from construction layout drawings (配置図)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "api:dev": "tsx watch src/api/server.ts",

    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:fresh": "npm run db:reset && npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",


    "test": "tsx src/test-runner.ts --workflow all",
    "test:all": "tsx src/test-runner.ts --workflow all",
    "test:drawing:clean-heimenzu": "tsx src/test-runner.ts --workflow all --drawing clean-heimenzu",
    "test:drawing:zumen": "tsx src/test-runner.ts --workflow all --drawing zumen_04b",

    "test:cloud-vision": "tsx src/test-runner.ts --workflow cloud-vision",
    "test:gemini": "tsx src/test-runner.ts --workflow gemini",
    "test:azure-layout": "tsx src/test-runner.ts --workflow azure-layout",
    "test:azure-read": "tsx src/test-runner.ts --workflow azure-read",

    "test:cloud-vision-gemini-hybrid": "tsx src/test-runner.ts --workflow cloud-vision-gemini-hybrid",
    "test:azure-read-gemini-hybrid": "tsx src/test-runner.ts --workflow azure-read-gemini-hybrid",
    "test:gemini-coordinates": "tsx src/test-runner.ts --workflow gemini-coordinates",
    "test:gemini-self-calibrating": "tsx src/test-runner.ts --workflow gemini-self-calibrating",

    "test:gemini-geometric": "tsx src/test-runner.ts --workflow gemini-geometric",

    "test:revit-pipeline": "tsx src/test-revit-pipeline.ts",
    "test:ai-pipeline": "tsx src/test-ai-pipeline.ts",

    "test:experiments": "tsx src/experiments/test-experiments.ts --experiment all",
    "test:exp:template-matching": "tsx src/experiments/test-experiments.ts --experiment template-matching",
    "test:exp:multi-ocr": "tsx src/experiments/test-experiments.ts --experiment multi-ocr-fusion",
    "test:exp:grid-overlay": "tsx src/experiments/test-experiments.ts --experiment grid-overlay",
    "test:exp:grid-20x20": "tsx src/experiments/test-experiments.ts --experiment grid-20x20",
    "test:exp:grid-40x40": "tsx src/experiments/test-experiments.ts --experiment grid-40x40",
    "test:exp:grid-80x80": "tsx src/experiments/test-experiments.ts --experiment grid-80x80",
    "test:exp:grid-100x100": "tsx src/experiments/test-experiments.ts --experiment grid-100x100",
    "test:exp:region-detection": "tsx src/experiments/test-experiments.ts --experiment region-detection",
    "test:exp:baseline": "tsx src/experiments/test-experiments.ts --experiment baseline",


    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "ocr",
    "construction",
    "drawings",
    "mastra",
    "gemini",
    "google-cloud-vision",
    "azure-document-intelligence"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.0.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@google-cloud/vision": "^4.3.2",
    "@google/generative-ai": "^0.21.0",
    "@mastra/core": "^0.23.1",
    "@mastra/mcp": "^0.14.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "fast-levenshtein": "^3.0.0",
    "fastify": "^5.6.1",
    "jimp": "^0.22.12",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "recharts": "^3.3.0",
    "sharp": "^0.34.5",
    "string-similarity": "^4.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/string-similarity": "^4.0.2",
    "drizzle-kit": "^0.28.1",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
